// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// USUARIOS
// ─────────────────────────────────────────
model User {
  id                  String         @id @default(cuid())
  fullName            String
  email               String         @unique
  phone               String?
  password            String
  role                Role           @default(CLIENT)
  status              UserStatus     @default(ACTIVE)
  hasCompletedMACForm Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  consultations         Consultation[]      @relation("ClientConsultations")
  assignedConsultations Consultation[]      @relation("SalespersonConsultations")
  consultationDrafts    ConsultationDraft[]
  passwordResetTokens   PasswordResetToken[]

  @@map("users")
}

enum Role {
  CLIENT
  SALESPERSON
  MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// ─────────────────────────────────────────
// CONSULTAS / SOLICITUDES MAC
// ─────────────────────────────────────────
model Consultation {
  id            String             @id @default(cuid())
  serviceType   String
  location      String
  postalCode    String
  latitude      Float?
  longitude     Float?
  projectTypes  String[]
  startDate     DateTime?
  installations String?
  budget        String?
  supportLevel  String?
  contactName   String
  organization  String?
  email         String
  phone         String?
  status        ConsultationStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  clientId      String
  client        User               @relation("ClientConsultations", fields: [clientId], references: [id])

  salespersonId String?
  salesperson   User?              @relation("SalespersonConsultations", fields: [salespersonId], references: [id])

  @@map("consultations")
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────
// BORRADORES MAC (guardado por pasos)
// ─────────────────────────────────────────
model ConsultationDraft {
  id        String   @id @default(cuid())
  userId    String   @unique   // Un borrador por usuario
  step      Int      @default(1)
  formData  Json                // Todo el formData serializado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consultation_drafts")
}

// ─────────────────────────────────────────
// TOKENS DE RESET DE CONTRASEÑA
// ─────────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────
// PRODUCTOS
// ─────────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  price       Float
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

// ─────────────────────────────────────────
// SOLICITUDES DE CONTACTO
// ─────────────────────────────────────────
model CustomerRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  services  String
  createdAt DateTime @default(now())

  @@map("customer_requests")
}
// ─────────────────────────────────────────
// Productos
// ─────────────────────────────────────────
model ProductCategory {
  id          String   @id @default(cuid())
  tipo        String
  descripcion String?
  imagen      String?
  items       Json     @default("[]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("product_categories")
}